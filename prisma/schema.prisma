generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  POSTULANTE
  EMPRESA
  SUPERADMIN
}

enum ApplicationStatus {
  ENVIADO
  EN_REVISION
  ENTREVISTA
  RECHAZADO
  CONTRATADO
}

enum Modality {
  REMOTO
  HIBRIDO
  PRESENCIAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postulante Postulante?
  empresa    Empresa?

  @@map("users")
}

model Departamento {
  id       String   @id @default(uuid())
  nombre   String   @unique
  ciudades Ciudad[]

  @@map("departamentos")
}

model Ciudad {
  id             String       @id @default(uuid())
  nombre         String
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  // Relaciones inversas
  empresas       Empresa[]
  jobOffers      JobOffer[]
  postulantes    Postulante[]  @relation("PostulanteCiudad")
  postulantesPref Postulante[] @relation("PostulanteCiudadPreferida")

  @@unique([nombre, departamentoId])
  @@map("ciudades")
}

model Sector {
  id        String     @id @default(uuid())
  nombre    String     @unique

  // Relaciones inversas
  empresas  Empresa[]
  jobOffers JobOffer[]
  postulantes Postulante[]

  @@map("sectores")
}

model Postulante {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos personales
  nombres         String
  apellidos       String
  telefono        String?
  fechaNacimiento DateTime?
  ciudadId        String?
  ciudad          Ciudad?  @relation("PostulanteCiudad", fields: [ciudadId], references: [id])

  // Perfil profesional
  skills          String[]
  cvUrl           String?
  cvPublicId      String?

  sobreMi          String?
  salarioEsperado  Int?
  linkedin         String?
  portfolio        String?
  fotoPerfil       String?
  fotoPerfilPublicId String?

  // Preferencias
  modalidadPreferida Modality?
  sectorId           String?
  sector             Sector?   @relation(fields: [sectorId], references: [id])
  ciudadPreferidaId  String?
  ciudadPreferida    Ciudad?   @relation("PostulanteCiudadPreferida", fields: [ciudadPreferidaId], references: [id])

  // Relaciones
  disabilities Disability[]
  applications Application[]
  savedJobs    SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("postulantes")
}

model Empresa {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos de empresa
  razonSocial     String?
  ruc             String?  @unique
  sectorId        String?
  sector          Sector?  @relation(fields: [sectorId], references: [id])
  tamaño          String?
  descripcion     String?
  sitioWeb        String?
  ciudadId        String?
  ciudad          Ciudad?  @relation(fields: [ciudadId], references: [id])
  direccion       String?

  // Contacto
  nombreContacto   String?
  cargoContacto    String?
  telefonoContacto String?

  // Logo y portada
  logoUrl         String?
  logoPublicId    String?
  portadaUrl      String?
  portadaPublicId String?

  // Estado
  isApproved      Boolean  @default(false)
  isVerified      Boolean  @default(false)
  submittedAt     DateTime @default(now())
  approvedAt      DateTime?

  // Acomodaciones
  accommodations  String[]

  // Relaciones
  jobOffers       JobOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresas")
}

model Disability {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  categoria   String?

  postulantes Postulante[]
  jobOffers   JobOffer[]

  createdAt   DateTime     @default(now())

  @@map("disabilities")
}

model JobOffer {
  id          String   @id @default(uuid())

  // Relación con empresa
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Datos del puesto
  titulo      String
  descripcion String
  requisitos  String[]
  funciones   String[]

  // Condiciones
  modalidad   Modality
  sectorId    String
  sector      Sector   @relation(fields: [sectorId], references: [id])
  ciudadId    String
  ciudad      Ciudad   @relation(fields: [ciudadId], references: [id])
  salarioMin  Int?
  salarioMax  Int?

  // Estado
  isActive    Boolean  @default(true)
  expiresAt   DateTime?

  // Relaciones
  disabilities Disability[]
  applications Application[]
  savedBy      SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_offers")
}

model Application {
  id           String            @id @default(uuid())

  postulanteId String
  postulante   Postulante        @relation(fields: [postulanteId], references: [id], onDelete: Cascade)

  jobOfferId   String
  jobOffer     JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  status       ApplicationStatus @default(ENVIADO)
  mensaje      String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([postulanteId, jobOfferId])
  @@map("applications")
}

model SavedJob {
  id           String     @id @default(uuid())

  postulanteId String
  postulante   Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade)

  jobOfferId   String
  jobOffer     JobOffer   @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([postulanteId, jobOfferId])
  @@map("saved_jobs")
}